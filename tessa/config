# Tessa - Vermilion Ink
# Compositor and shared theme settings.
# Panel settings live in ~/.config/tessa/panel.conf.
# Reload with Super+R or `tessa-ctl dispatch reload`.

terminal = kitty
gaps = 10
outer_gaps = 18
border_width = 2
master_ratio = 0.62
master_count = 1
mosaic_ratio = 0.64
mosaic_min_size = 180
grid_columns = 0
frame_time_budget = 16

# Layouts and motion ---------------------------------------------------------
layout = master
animations = true
animation_ms = 170
animation_open_ms = 190
animation_workspace_ms = 260
animation_close_ms = 170
animation_curve = ease-out-cubic
animation_open_curve = ease-out-quint
animation_workspace_curve = spring-soft
animation_close_curve = ease-out-cubic
animation_open_y = 22
animation_workspace_offset = 64
animation_close_scale = 0.94
animation_close_fade = true
reduce_motion = false
reduce_motion_animations = fade

# Window effects -------------------------------------------------------------
shadows = true
corner_radius = 14
blur = true
blur_radius = 8
blur_passes = 3

# Window rules ---------------------------------------------------------------
window-rule = app-id=kitty; corner-radius=14; blur=true
window-rule = app-id=foot; corner-radius=14; blur=true
window-rule = app-id=firefox; opacity=0.99; corner-radius=14; blur=true
window-rule = app-id=org.mozilla.firefox; opacity=0.99; corner-radius=14; blur=true
window-rule = app-id=org.gnome.Nautilus; opacity=0.98; corner-radius=14
window-rule = app-id=org.telegram.desktop; opacity=0.98; corner-radius=14
window-rule = app-id=vesktop; opacity=0.98; corner-radius=14
window-rule = title=Picture-in-Picture; float=true; size=560x316; position=1290,90; opacity=0.92; corner-radius=18; blur=true
window-rule = app-id=pavucontrol; float=true; size=760x560; corner-radius=16; blur=true
window-rule = app-id=blueman-manager; float=true; size=760x600; corner-radius=16
window-rule = app-id=org.gnome.Calculator; float=true; size=420x600; corner-radius=16
window-rule = app-id=mpv; corner-radius=0; border-width=0; shadow=false
window-rule = app-id=imv; opacity=0.98; corner-radius=10

# Workspace names ------------------------------------------------------------
workspace-name = 1 一
workspace-name = 2 二
workspace-name = 3 三
workspace-name = 4 四
workspace-name = 5 五
workspace-name = 6 六
workspace-name = 7 七
workspace-name = 8 八
workspace-name = 9 九

# Special workspaces ---------------------------------------------------------
special-workspace = notes
special-workspace = tools
window-rule = app-id=org.gnome.TextEditor; special=notes; size=720x560
window-rule = app-id=org.gnome.Console; special=tools; size=760x520
bind = SUPER+ALT+n special notes
bind = SUPER+ALT+SHIFT+n move-to-special notes
bind = SUPER+ALT+t special tools
bind = SUPER+ALT+SHIFT+t move-to-special tools

# Shell / panel --------------------------------------------------------------
# The compositor starts the panel; panel-only settings live in panel.conf.
panel = true

layer-rule = namespace=tessa-background; opacity=1; corner-radius=0; blur=false
layer-rule = namespace=tessa-bar; opacity=0.93; corner-radius=16; blur=true
layer-rule = namespace=tessa-notifications; opacity=0.98; corner-radius=0; blur=true
layer-rule = namespace=tessa-overlay; opacity=1; corner-radius=0; blur=true

# Input ----------------------------------------------------------------------
input = type=touchpad; tap=true; tap-drag=true; natural-scroll=true; dwt=true; accel-profile=adaptive; scroll-method=two-finger
input = type=mouse; natural-scroll=false
kb_layout = us
kb_variant =
kb_options =
kb_model =
kb_rules =
repeat_rate = 30
repeat_delay = 500
gestures = true
gesture_fingers = 3
gesture_workspace_threshold = 400
gesture_launcher_threshold = 300
touch = true
tablet = true
pointer_constraints = true
cursor_theme = Adwaita
cursor_size = 26

# Applications ---------------------------------------------------------------
xwayland = true
xwayland_display = auto
xim = true
xim_server = fcitx
# Started after the XWayland socket exists, when both the Wayland socket and
# DISPLAY are ready, so fcitx5 serves text-input-v3 and XIM at once.
xim_start = fcitx5 -d --replace

# Palette --------------------------------------------------------------------
accent = #e2684f
bg = #070a12
bg_top = #101827
bg_bottom = #04060b
border_active = #e2684f
border_inactive = #26313f
theme-role = accent = #e2684f
theme-role = window.border.active = #e2684f
theme-role = window.border.inactive = #26313f
theme-role = window.background = #070a12
theme-role = panel.background = #0b111b
theme-role = panel.foreground = #f0eadf
theme-role = wallpaper.top = #101827
theme-role = wallpaper.bottom = #04060b

# Extra bindings -------------------------------------------------------------
bind = SUPER+SHIFT+Return spawn kitty
bind = SUPER+ALT+i spawn kitty --hold -e fastfetch
